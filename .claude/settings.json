      "Bash(export *)",
      "Bash(set *)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "Bash(Get-ChildItem Env:*)",
      "Bash(gci Env:*)",
      "Bash(dir Env:*)",
      "Bash(rm *)",
      "Bash(Remove-Item *)",
      "Bash(del *)",
      "Bash(rmdir *)",
      "Bash(rd *)",
      "Bash(format *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)"
